<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Tab Navigation"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Text"
                        name="./text"/>
                </items>
            </column>
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <elements
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Elements"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <elements
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldDescription="Add one or more tab elements."
                                fieldLabel="Elements"
                                name="./elements">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container">
                                    <items jcr:primaryType="nt:unstructured">
                                        <linkTitle
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldDescription="Enter the title displayed on the tab."
                                            fieldLabel="Link title"
                                            name="./linkTitle"
                                            required="{Boolean}true"/>
                                        <link
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldDescription="Select the content page this tab links to."
                                            fieldLabel="Link"
                                            name="./link"
                                            required="{Boolean}true"
                                            rootPath="/content"/>
                                    </items>
                                </field>
                            </elements>
                        </items>
                    </elements>
                    <accessibility
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Accessibility"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <ariaLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Provide an aria-label for screen readers describing this tab navigation."
                                fieldLabel="Aria label for accessibility"
                                name="./ariaLabel"/>
                        </items>
                    </accessibility>
                    <visualVariations
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Visual Variations"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <visualStyle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="Choose the visual appearance of the tab navigation."
                                fieldLabel="Visual Style"
                                name="./visualStyle">
                                <items jcr:primaryType="nt:unstructured">
                                    <default
                                        jcr:primaryType="nt:unstructured"
                                        text="Default"
                                        value="default"/>
                                    <primary
                                        jcr:primaryType="nt:unstructured"
                                        text="Primary"
                                        value="primary"/>
                                    <secondary
                                        jcr:primaryType="nt:unstructured"
                                        text="Secondary"
                                        value="secondary"/>
                                    <minimal
                                        jcr:primaryType="nt:unstructured"
                                        text="Minimal"
                                        value="minimal"/>
                                </items>
                            </visualStyle>
                        </items>
                    </visualVariations>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
